{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "test/(e2e|auth)/.+\\.(e2e\\.)?spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testTimeout": 60000,
  "setupFilesAfterEnv": ["jest-expect-message"],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1"
  },
  "silent": true,

  "globalSetup": "<rootDir>/setup/global-setup.ts"
}

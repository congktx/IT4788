{
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": "(e2e|auth|products|news)/.+\\.(e2e[.-])?spec\\.ts$",
    "transform": {
        "^.+\\.(t|j)s$": "ts-jest"
    },
    "testTimeout": 60000,
    "setupFilesAfterEnv": ["<rootDir>/setup/jest-expect-message.ts"],
    "moduleNameMapper": {
        "^src/(.*)$": "<rootDir>/../src/$1"
    },
    "silent": true,
    "testSequencer": "<rootDir>/test-sequencer.js"
}
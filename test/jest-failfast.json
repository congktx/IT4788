{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "e2e/.+\\.failfast.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testTimeout": 30000,
  "setupFilesAfterEnv": ["jest-expect-message"],
  "reporters": ["default", "<rootDir>/helpers/fail-fast-reporter.js"],
  "silent": true
}
